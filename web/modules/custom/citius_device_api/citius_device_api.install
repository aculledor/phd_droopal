<?php

/**
 * @file
 * Install, update and uninstall hooks for citius_device_api.
 */

use Drupal\citius_device_api\ExercisePayloadStorage;

/**
 * Implements hook_schema().
 */
function citius_device_api_schema(): array {
  $schema[ExercisePayloadStorage::TABLE_RAW] = [
    'description' => 'Raw JSON payloads received by POST /api/exercise.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'received_at' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'Server receipt timestamp.',
      ],
      'device_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Device id inferred from the bearer token, when available.',
      ],
      'user_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'User id from metadata, when available.',
      ],
      'routine_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Routine/session id from metadata, when available.',
      ],
      'payload_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'unknown',
        'description' => 'Detected payload type.',
      ],
      'raw_payload_json' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'Raw request body.',
      ],
      'validation_status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => ExercisePayloadStorage::STATUS_RECEIVED,
        'description' => 'Validation result: received, valid, partially_valid, or invalid.',
      ],
      'validation_errors' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'JSON encoded list of validation errors.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'received_at' => ['received_at'],
      'payload_type' => ['payload_type'],
      'user_id' => ['user_id'],
      'routine_id' => ['routine_id'],
      'device_id' => ['device_id'],
    ],
  ];

  $schema[ExercisePayloadStorage::TABLE_TRACKING] = [
    'description' => 'Normalized movement tracking samples received by POST /api/exercise.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'raw_payload_id' => [
        'type' => 'int',
        'not null' => FALSE,
        'unsigned' => TRUE,
        'description' => 'Related raw payload id.',
      ],
      'received_at' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'Server receipt timestamp.',
      ],
      'sample_timestamp' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Sample timestamp sent by the device.',
      ],
      'user_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'routine_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'exercise_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'exercise_type_code' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'legacy_game_event' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'sample_interval_seconds' => [
        'type' => 'float',
        'not null' => FALSE,
      ],
      'movement_data_json' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'JSON encoded movement_data object, including position and rotation.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'raw_payload_id' => ['raw_payload_id'],
      'received_at' => ['received_at'],
      'user_id' => ['user_id'],
      'routine_id' => ['routine_id'],
      'exercise_id' => ['exercise_id'],
    ],
  ];

  return $schema;
}

/**
 * Creates raw payload/tracking tables.
 */
function citius_device_api_update_11001(): void {
  $schema = \Drupal::database()->schema();
  $table_schema = citius_device_api_schema();

  foreach ([ExercisePayloadStorage::TABLE_RAW, ExercisePayloadStorage::TABLE_TRACKING] as $table_name) {
    if (!$schema->tableExists($table_name)) {
      $schema->createTable($table_name, $table_schema[$table_name]);
    }
  }
}


/**
 * Removes transient execution rotation field definitions from the previous build.
 */
function citius_device_api_update_11002(): void {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $directions = ['head', 'left', 'right'];
  $axes = ['x', 'y', 'z', 'w'];

  foreach ($directions as $direction) {
    foreach ($axes as $axis) {
      $field_name = sprintf('%s_rot_%s', $direction, $axis);
      $field_storage_definition = $entity_definition_update_manager->getFieldStorageDefinition($field_name, 'execution');
      if ($field_storage_definition !== NULL) {
        $entity_definition_update_manager->uninstallFieldStorageDefinition($field_storage_definition);
      }
    }
  }
}

/**
 * Ensures raw payload/tracking tables exist.
 */
function citius_device_api_update_11003(): void {
  $schema = \Drupal::database()->schema();
  $table_schema = citius_device_api_schema();

  foreach ([ExercisePayloadStorage::TABLE_RAW, ExercisePayloadStorage::TABLE_TRACKING] as $table_name) {
    if (!$schema->tableExists($table_name)) {
      $schema->createTable($table_name, $table_schema[$table_name]);
    }
  }
}

/**
 * Installs execution rotation base fields.
 */
function citius_device_api_update_11004(): void {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();

  $entity_type = $entity_type_manager->getDefinition('execution');
  $field_definitions = \Drupal\citius_device_api\Entity\Execution::baseFieldDefinitions($entity_type);

  $rotation_fields = [
    'head_rot_x',
    'head_rot_y',
    'head_rot_z',
    'head_rot_w',
    'left_rot_x',
    'left_rot_y',
    'left_rot_z',
    'left_rot_w',
    'right_rot_x',
    'right_rot_y',
    'right_rot_z',
    'right_rot_w',
  ];

  foreach ($rotation_fields as $field_name) {
    $existing = $entity_definition_update_manager->getFieldStorageDefinition($field_name, 'execution');

    if ($existing === NULL && isset($field_definitions[$field_name])) {
      $entity_definition_update_manager->installFieldStorageDefinition(
        $field_name,
        'execution',
        'citius_device_api',
        $field_definitions[$field_name]
      );
    }
  }
}